# EduCenter Backend Environment Variables
# Copy this file to .env and fill in your values

# ===========================
# Server Configuration
# ===========================
PORT=5000
NODE_ENV=development

# ===========================
# MongoDB Configuration
# ===========================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/educenter
# Optional comma-separated DNS servers for MongoDB SRV lookup
# MONGODB_DNS_SERVERS=1.1.1.1,1.0.0.1

# MongoDB Atlas (production)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/educenter?retryWrites=true&w=majority

# ===========================
# JWT Configuration
# ===========================
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ===========================
# CORS Configuration
# ===========================
CORS_ORIGIN=http://localhost:5173

# ===========================
# Frontend / Email Verification
# ===========================
# Base URL of the frontend used to build verification links
FRONTEND_URL=http://localhost:5173
# Optional override for the full verification page URL
# VERIFY_EMAIL_URL=http://localhost:5173/verify-email

# ===========================
# Google OAuth (Sign in with Google)
# ===========================
# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=

# ===========================
# SMTP (registration & password reset emails)
# ===========================
# Leave SMTP_HOST/SMTP_USER/SMTP_FROM empty in development to log the
# verification link / reset code to the server console instead.
SMTP_HOST=
# 587 = STARTTLS (SMTP_SECURE=false), 465 = implicit TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Gmail example (requires an App Password, not your normal password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM="EduCenter" <your.email@gmail.com>

# ===========================
# Rate Limiting
# ===========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===========================
# Payment Gateway (Mock)
# ===========================
PAYMENT_GATEWAY_URL=http://localhost:5001/mock-gateway
PAYMENT_GATEWAY_SECRET=mock_payment_secret
